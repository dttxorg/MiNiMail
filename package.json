{
  "name": "minimail",
  "version": "0.1.2",
  "description": "Spark-style email client for Windows",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "build": "npm run build:vite && npm run build:electron",
    "build:vite": "vite build",
    "build:electron": "tsc -b tsconfig.main.json --force",
    "test:release": "node scripts/test-release.cjs",
    "rebuild:native:mac": "electron-rebuild -f -w better-sqlite3",
    "package:mac": "npm run rebuild:native:mac && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir",
    "dist:mac": "npm run rebuild:native:mac && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "keywords": [
    "email",
    "client",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "dompurify": "^3.3.3",
    "electron-log": "^5.4.3",
    "google-auth-library": "^10.6.2",
    "html-to-image": "^1.11.13",
    "i18next": "^26.0.3",
    "imapflow": "^1.3.1",
    "lucide-react": "^1.7.0",
    "mailparser": "^3.9.6",
    "nodemailer": "^8.0.5",
    "quill": "^2.0.2",
    "react-i18next": "^17.0.2"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/dompurify": "^3.0.5",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.2",
    "vite": "^8.0.7",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.minimail.email",
    "productName": "MiNiMail",
    "icon": "build/icons/icon.ico",
    "directories": {
      "output": "release8"
    },
    "files": [
      "dist/**/*",
      "build/icons/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "icon": "build/icons/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "installerIcon": "build/icons/icon.ico",
      "uninstallerIcon": "build/icons/icon.ico",
      "installerHeaderIcon": "build/icons/icon.ico",
      "shortcutName": "MiNiMail"
    }
  }
}
